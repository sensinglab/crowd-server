# Exemplo SEM credenciais. Copiar e preencher num ficheiro privado, fora do Git.
# O systemd lê /etc/monicrowd/server.env; não lê automaticamente o ambiente de uma .venv.
MQTT_HOST=your_mqtt_host
MQTT_PORT=1883
MQTT_USER=your_mqtt_user
MQTT_PASS=your_new_mqtt_password
PG_HOST=127.0.0.1
PG_DB=sensorsconfiguration
PG_USER=your_postgresql_user
PG_PASS=your_new_postgresql_password
PG_DSN=host=127.0.0.1 dbname=sensorsconfiguration user=your_postgresql_user password=your_new_postgresql_password
TTN_MQTT_HOST=your_ttn_mqtt_host
TTN_MQTT_PORT=8883
TTN_APP_ID=your_ttn_application_id
TTN_MQTT_USER=your_ttn_application_id@ttn
TTN_MQTT_PASSWORD=your_new_ttn_api_key
