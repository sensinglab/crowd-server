# Modelo público. Definir os valores reais só no ambiente privado do Telegraf.
# A instalação Debian/RPM pode usar /etc/default/telegraf; verificar o serviço instalado.
TTN_MQTT_URL=ssl://your_ttn_host:8883
TTN_MQTT_USER=your_ttn_application_id@ttn
TTN_MQTT_PASSWORD=your_new_ttn_key
TTN_UPLINK_TOPIC=v3/your_ttn_application_id@ttn/devices/+/up
MQTT_URL=tcp://your_mqtt_host:1883
MQTT_USER=your_mqtt_user
MQTT_PASS=your_new_mqtt_password
WIFI_COUNT_TOPIC=your_wifi_count_topic
WIFI_LOCATION_TOPIC=your_wifi_location_topic
HELIUM_MQTT_URL=tcp://your_helium_broker:1883
HELIUM_MQTT_USER=your_helium_user
HELIUM_MQTT_PASSWORD=your_new_helium_password
HELIUM_COUNT_TOPIC=your_helium_count_topic
HELIUM_LOCATION_TOPIC=your_helium_location_topic
PG_DSN=host=127.0.0.1 dbname=your_database user=your_pg_user password=your_new_pg_password
INFLUX_URL=http://your_influx_host:8086
INFLUX_TOKEN=your_new_influx_token
INFLUX_ORG=your_organization
INFLUX_DEFAULT_BUCKET=your_default_bucket
